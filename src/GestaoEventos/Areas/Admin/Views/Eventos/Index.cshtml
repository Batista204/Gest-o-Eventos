@model List<EventoListaViewModel>
@{
    ViewData["Title"] = "Eventos";
    var filtro = ViewData["Filtro"] as StatusEvento?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Eventos</h1>
    <a asp-action="Create" class="btn btn-primary">Novo evento</a>
</div>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm @(filtro is null ? "btn-dark" : "btn-outline-dark")">Todos</a>
    @foreach (var s in Enum.GetValues<StatusEvento>())
    {
        <a asp-action="Index" asp-route-status="@s"
           class="btn btn-sm @(filtro == s ? "btn-dark" : "btn-outline-dark")">@s</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum evento encontrado.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Data</th>
                    <th>Local</th>
                    <th>Vagas</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Titulo</td>
                        <td>@item.DataEvento.ToString("dd/MM/yyyy") às @item.HoraInicio.ToString("HH:mm")</td>
                        <td>@item.Local</td>
                        <td>@item.VagasOcupadas / @item.LimiteVagas</td>
                        <td><partial name="_StatusBadge" model="item.Status" /></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalhes</a>
                            @if (item.Status is StatusEvento.Planejado or StatusEvento.Aberto)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}