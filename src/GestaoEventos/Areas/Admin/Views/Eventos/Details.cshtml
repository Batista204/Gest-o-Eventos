@model EventoDetalhesViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Titulo</h1>
        <partial name="_StatusBadge" model="Model.Status" />
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar à lista</a>
</div>

<p>@Model.Descricao</p>

<dl class="row">
    <dt class="col-sm-3">Data</dt>
    <dd class="col-sm-9">@Model.DataEvento.ToString("dd/MM/yyyy"), das @Model.HoraInicio.ToString("HH:mm") às @Model.HoraFim.ToString("HH:mm")</dd>

    <dt class="col-sm-3">Local</dt>
    <dd class="col-sm-9">@Model.Local</dd>

    <dt class="col-sm-3">Carga horária</dt>
    <dd class="col-sm-9">@Model.CargaHoraria.ToString("0.#") hora(s)</dd>

    <dt class="col-sm-3">Vagas</dt>
    <dd class="col-sm-9">@Model.VagasOcupadas ocupadas de @Model.LimiteVagas</dd>

    <dt class="col-sm-3">Inscrições</dt>
    <dd class="col-sm-9">de @Model.InicioInscricao.ToString("dd/MM/yyyy HH:mm") até @Model.FimInscricao.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Organizador</dt>
    <dd class="col-sm-9">@Model.OrganizadorNome</dd>
</dl>

<hr />

<div class="d-flex flex-wrap gap-2">
    @if (Model.PodeEditar)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Editar</a>
    }

    @if (Model.Status == StatusEvento.Planejado)
    {
        <form asp-action="AlterarStatus" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="novoStatus" value="@StatusEvento.Aberto" />
            <button type="submit" class="btn btn-success">Abrir inscrições</button>
        </form>
    }

    @if (Model.Status == StatusEvento.Aberto)
    {
        <form asp-action="AlterarStatus" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Encerrar o evento? Depois disso a presença não poderá mais ser alterada.');">
            <input type="hidden" name="novoStatus" value="@StatusEvento.Encerrado" />
            <button type="submit" class="btn btn-dark">Encerrar evento</button>
        </form>
    }

    @if (Model.PodeEditar)
    {
        <form asp-action="AlterarStatus" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Cancelar este evento? Essa ação não pode ser desfeita.');">
            <input type="hidden" name="novoStatus" value="@StatusEvento.Cancelado" />
            <button type="submit" class="btn btn-outline-danger">Cancelar evento</button>
        </form>
    }

    @if (Model.PodeExcluir)
    {
        <form asp-action="Excluir" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('Excluir definitivamente este evento?');">
            <button type="submit" class="btn btn-danger">Excluir</button>
        </form>
    }
</div>