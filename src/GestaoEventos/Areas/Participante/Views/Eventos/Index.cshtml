@model List<EventoDisponivelViewModel>
@{
    ViewData["Title"] = "Eventos disponíveis";
}

<h1 class="h3 mb-4">Eventos disponíveis</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum evento com inscrições abertas no momento.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 card-title">@item.Titulo</h2>
                        <p class="text-muted mb-1">
                            @item.DataEvento.ToString("dd/MM/yyyy") às @item.HoraInicio.ToString("HH:mm") - @item.Local
                        </p>
                        <p class="mb-2">@item.VagasDisponiveis vaga(s) disponível(is) de @item.LimiteVagas</p>
                        @if (item.JaInscrito)
                        {
                            <span class="badge text-bg-primary">Inscrito</span>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Ver detalhes</a>
                    </div>
                </div>
            </div>
        }
    </div>
}